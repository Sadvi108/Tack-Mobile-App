# ---- client-safe (compiled into the Flutter bundle) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
APP_ENV=dev

# ---- server-only (Supabase Edge Function secrets — NEVER in the app) ----
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
GEMINI_API_KEY=
AI_PROVIDER=mock
CRON_SECRET=

# Radar: server-side job providers. JSearch uses the OpenWeb Ninja direct key.
JSEARCH_API_KEY=
CAREERJET_API_KEY=
CAREERJET_LOCALE=en_BD

# Completed runs of a dedicated Apify Bdjobs search task; server only.
APIFY_API_TOKEN=
APIFY_BDJOBS_TASK_ID=
# Optional comma-separated saved task IDs for the supported Bangladesh job actors.
# Up to eight; the original single task above is also included when set.
APIFY_JOB_TASK_IDS=
